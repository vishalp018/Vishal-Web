<script async type="module"
src="https://cdn.jsdelivr.net/npm/@finsweet/attributes@2/attributes.js" fs-toc></script>
<script>

document.addEventListener("DOMContentLoaded", function () {
	
  const openBtn = document.getElementById("open-video");
  const popup = document.querySelector(".product-video-pop-up-wp");
  const closeBtn = document.querySelector(".close_pop-up");
  const iframe = popup.querySelector("iframe");

  // OPEN
  openBtn.addEventListener("click", function () {
    popup.style.display = "flex";
    document.body.style.overflow = "hidden"; // prevent scroll
  });

  // CLOSE BUTTON
  closeBtn.addEventListener("click", function () {
    popup.style.display = "none";
    document.body.style.overflow = "auto";
    iframe.src = iframe.src; // stop video
  });

  // CLICK OUTSIDE
  popup.addEventListener("click", function (e) {
    if (e.target === popup) {
      popup.style.display = "none";
      document.body.style.overflow = "auto";
      iframe.src = iframe.src;
    }
  });

  // ESC KEY CLOSE
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      popup.style.display = "none";
      document.body.style.overflow = "auto";
      iframe.src = iframe.src;
    }
  });

});

</script></body></html>